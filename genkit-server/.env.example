# Copy this file to .env and fill in your own values.

# Google AI Studio API key (https://aistudio.google.com/app/apikey)
# Used by @genkit-ai/googleai for the text-embedding-004 embedder.
GOOGLE_GENAI_API_KEY=your_google_ai_studio_api_key

# Supabase project credentials.
# IMPORTANT: this must be the SERVICE ROLE key, not the anon key — the
# server needs to read/write the `embedding` column and call the
# match_research_papers() RPC across all papers, bypassing RLS.
# Get it from: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Protects the scheduled Vercel /reindex endpoint. Set the same random value
# in the Vercel project environment variables as CRON_SECRET.
CRON_SECRET=replace_with_a_random_secret_at_least_16_characters

# Port the Genkit/Express server listens on
PORT=8787

# Optional frontend metadata extraction endpoint.
# When set, the app can call /extract-metadata on this server for AI-based
# document metadata extraction instead of relying only on heuristic parsing.
# VITE_GENKIT_METADATA_URL=http://localhost:8787/extract-metadata
