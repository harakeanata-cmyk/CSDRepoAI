# Copy this file to .env and fill in your own Supabase project credentials.
# Get these from: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Google Genkit semantic search (see /genkit-server for the actual service).
# Run `npm install && npm run dev` inside genkit-server, then point these
# at it. Both are optional — without them the app falls back to Postgres
# full-text search automatically.
VITE_GENKIT_SEARCH_URL=http://localhost:8787/search
VITE_GENKIT_EMBED_URL=http://localhost:8787/embed
VITE_GENKIT_METADATA_URL=http://localhost:8787/extract-metadata

# Server-only variables for the root Vercel API routes. Never add the VITE_
# prefix to these keys; VITE_ values are exposed to browser code.
GOOGLE_GENAI_API_KEY=your_google_ai_studio_api_key
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Used by the scheduled /reindex route. Generate a private random value.
CRON_SECRET=your_private_cron_secret
