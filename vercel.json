{
  "routes": [
    {
      "src": "/(search|check-duplicate|embed|metadata|extract-metadata|format-review|health|admin/users)",
      "dest": "/api/index.js"
    },
    { "handle": "filesystem" },
    { "src": "/assets/.*", "status": 404 },
    { "src": "/ort-wasm/.*", "status": 404 },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" }
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
